#!/bin/bash
# ============================================================
# 打开钉钉开发者后台，并把回调地址复制到剪贴板
#
# 钉钉后台没有开放「改应用配置」的接口，这一步只能在网页上点，
# 脚本能帮的就是：把地址替你复好、页面替你打开。
#
# 双击运行。
# ============================================================

REDIRECT="https://rlone11.github.io/scau-water-inventory/"

cd "$(dirname "$0")" || exit 1

printf '%s' "$REDIRECT" | pbcopy

echo "=============================================="
echo "  钉钉后台 · 配置回调地址"
echo "=============================================="
echo ""
echo "  回调地址已经复制到剪贴板了："
echo ""
echo "    $REDIRECT"
echo ""
echo "  ⚠️ 末尾那个斜杠不能少，少一个字符钉钉就会报"
echo "     「redirect_uri 与回调域名不一致」"
echo ""
echo "  接下来在打开的页面里点："
echo ""
echo "    1. 用钉钉扫码登录（用你平时管学院那个号）"
echo "    2. 列表里点开「水院物品管理系统」"
echo "       ⚠️ 新版路径是 应用开发 → 企业内部应用 > 钉钉应用"
echo "          （旧版叫「企业内部开发」，一字之差）"
echo "    3. 左侧：开发配置 → 安全设置"
echo "    4. 找到「重定向URL（回调域名）」输入框"
echo "    5. 按 Cmd+V 粘贴，点「添加」或「保存」"
echo ""
echo "  ⚠️ 如果报错、或者提示要备案，把错误原文截图发给 Claude。"
echo "     这是整件事的卡脖子点，存不进去后面全要改方案。"
echo ""
echo "  顺手还要看一眼：左侧「权限管理」里这两个是不是已开通 ——"
echo "    个人手机号信息 / 通讯录个人信息读权限"
echo ""

# 直接开应用列表页，省得在菜单里翻
open "https://open-dev.dingtalk.com/v2/fe/app#/corp/app"

echo "  浏览器已打开。配完回来跟 Claude 说一声。"
echo ""
read -n 1 -s -r -p "按任意键关闭这个窗口..."
